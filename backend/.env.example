# App Config
PROJECT_NAME="Voice Technician Assistant"
API_V1_STR="/api/v1"
SECRET_KEY="development-only-secret-key-replace-in-production-environments"
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Database Config
DATABASE_URL=sqlite+aiosqlite:///./voice_bot.db

# Redis Config
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# LLM & STT General Configurations
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash

# Gemini & LiveKit Credentials
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# LiveKit — matches livekit/livekit.yaml  keys: devkey: secret
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"

# Settings
LOG_LEVEL=INFO
ENVIRONMENT=development
